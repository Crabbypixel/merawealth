# Copy this file to backend/.env and fill in the values.
# Each environment (your laptop, staging, production) has its OWN .env file.
# Never commit a real .env file; it is already ignored by git.

# "production" on the live server only. Use "development" locally and on staging
# unless staging is served over HTTPS (secure cookies need HTTPS).
NODE_ENV=development

# Port the NestJS API listens on.
PORT=3001

# Postgres connection string. Staging and local MUST point at their own database,
# never at the production one.
# Example: postgresql://merawealth:CHANGE_ME@localhost:5432/merawealth_staging
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Where the frontend runs. Used for CORS, so it must match the browser address exactly.
# Examples: http://localhost:3000, https://staging.merawealth.in
FRONTEND_URL=http://localhost:3000

# Gmail account used to send OTP and order emails (use a Gmail "App password").
# Staging and local should use a separate test Gmail account, not the production sender.
EMAIL_USER=your-test-account@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
