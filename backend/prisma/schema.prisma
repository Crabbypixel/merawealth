// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionTerminationReason {
  LOGOUT
  NEW_LOGIN
  EXPIRED
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

enum Role {
  ADMIN
  CLIENT
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum TransactionType {
  BUY
  SELL
}

enum TransactionStatus {
  PENDING
  UNDER_PROCESS
  PARTIALLY_COMPLETED
  COMPLETED
  REJECTED
  CANCELLED
}

model Admin {
  id Int @id @default(autoincrement())

  name        String
  phoneNumber String @unique
  email       String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otpLogs            OtpLog[]
  sessions           Session[]
  transactionMatches TransactionMatch[]
}

model User {
  id Int @id @default(autoincrement())

  phoneNumber String @unique
  email       String @unique
  name        String

  panNumber     String? @db.Char(10)
  dematClientId String? @db.VarChar(8)
  dematDpId     String? @db.VarChar(8)
  bankAccountNo String? @db.VarChar(34)
  ifscCode      String? @db.Char(11)
  bankName      String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status UserStatus @default(PENDING)

  otpLogs      OtpLog[]
  sessions     Session[]
  transactions Transaction[]
}

// Exactly one of userId or adminId must be non-null.
// The role field indicates which identity owns the OTP/session.
model OtpLog {
  id Int @id @default(autoincrement())

  challenge String @unique

  otp  Int
  used Boolean @default(false)

  // Wrong guesses so far; the code stops working after 5
  attempts Int @default(0)

  expiresAt DateTime
  createdAt DateTime @default(now())

  role Role

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  adminId Int?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

// Exactly one of userId or adminId must be non-null.
// The role field indicates which identity owns the OTP/session.
model Session {
  id Int @id @default(autoincrement())

  sessionToken String  @unique
  isActive     Boolean @default(true)

  role Role

  createdAt DateTime  @default(now())
  expiresAt DateTime
  logoutAt  DateTime?

  terminationReason SessionTerminationReason?

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  adminId Int?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model Company {
  companyCode String @id @db.VarChar(8)

  companyName String  @unique
  companyLogo String
  companyUrl  String?
  shortNote   String?

  indicativePrice Decimal       @db.Decimal(18, 2)
  minQty          Int
  isActive        CompanyStatus @default(INACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       Transaction[]
  transactionMatches TransactionMatch[]
}

model Transaction {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  companyCode String
  company     Company @relation(fields: [companyCode], references: [companyCode])

  type TransactionType

  quantity Int

  // Set by the admin when approving (PENDING -> UNDER_PROCESS), between 1 and quantity.
  // Order matching works on approvedQuantity, not on the quantity the client ordered.
  // Invariant: pendingQuantity = approvedQuantity - matchedQuantity
  approvedQuantity Int @default(0)
  matchedQuantity  Int @default(0)
  pendingQuantity  Int @default(0)

  priceAtOrder Decimal @db.Decimal(12, 2)
  totalAmount  Decimal @db.Decimal(14, 2)

  status TransactionStatus @default(PENDING)

  adminRemarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches TransactionMatch[]

  @@index([status])
  @@index([userId])
}

// One row per order per manual match. Rows that share companyCode + matchId
// form one match: their SELL quantities add up to their BUY quantities.
// Order details (client, dates, quantities, price) are read from the linked order.
model TransactionMatch {
  id Int @id @default(autoincrement())

  // Typed by the admin (e.g. "M1"), stored trimmed and upper-case.
  // Never reused for the same company once confirmed.
  matchId String @db.VarChar(20)

  companyCode String
  company     Company @relation(fields: [companyCode], references: [companyCode])

  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  quantity Int

  matchedByAdminId Int
  matchedByAdmin   Admin @relation(fields: [matchedByAdminId], references: [id])

  matchDate DateTime @default(now())

  @@index([companyCode, matchId])
  @@index([transactionId])
}
